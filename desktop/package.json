{
  "name": "amoeditor-desktop",
  "version": "1.0.0",
  "description": "Native AmoEditor desktop workspace connected to AmoEvents",
  "author": "Grey Interactive",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "main": "main.mjs",
  "scripts": {
    "dev": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.greyinteractive.amoeditor",
    "productName": "AmoEditor",
    "asar": true,
    "files": [
      "main.mjs",
      "preload.mjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "web"
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "category": "Graphics",
      "target": ["AppImage"]
    }
  }
}
